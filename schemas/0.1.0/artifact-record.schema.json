{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:schema:artifact-record:0.1.0",
  "title": "DACN artifact record",
  "type": "object",
  "allOf": [
    { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/record_envelope" },
    {
      "if": {
        "properties": { "available": { "const": false } },
        "required": ["available"]
      },
      "then": {
        "required": ["unavailable_reason"],
        "not": { "anyOf": [{ "required": ["path"] }, { "required": ["sha256"] }, { "required": ["size_bytes"] }] }
      },
      "else": { "required": ["path", "sha256", "size_bytes"] }
    }
  ],
  "required": ["schema", "schema_version", "id", "case_id", "provenance", "kind", "available"],
  "properties": {
    "schema": { "const": "artifact-record" },
    "schema_version": { "const": "0.1.0" },
    "id": {},
    "case_id": {},
    "provenance": {},
    "kind": { "type": "string", "minLength": 1 },
    "available": { "type": "boolean" },
    "path": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/relative_path" },
    "sha256": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/sha256" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "unavailable_reason": { "type": "string", "minLength": 1 },
    "media_type": { "type": "string", "minLength": 1 },
    "producer": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/record_ref" },
    "derived_from": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/artifact_ref" }
    },
    "description": { "type": "string" }
  },
  "unevaluatedProperties": false
}
