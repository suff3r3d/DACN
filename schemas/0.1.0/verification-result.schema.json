{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:schema:verification-result:0.1.0",
  "title": "DACN verification result",
  "type": "object",
  "allOf": [
    { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/record_envelope" },
    {
      "if": {
        "properties": { "verdict": { "const": "VERIFIED" } },
        "required": ["verdict"]
      },
      "then": {
        "not": { "required": ["failure_class"] },
        "properties": {
          "checks": {
            "properties": {
              "environment_and_build_identity": { "$ref": "#/$defs/passed_check" },
              "same_candidate": { "$ref": "#/$defs/passed_check" },
              "vulnerable_target_signal": { "$ref": "#/$defs/passed_check" },
              "reachability": { "$ref": "#/$defs/passed_check" },
              "patched_behavior": { "$ref": "#/$defs/passed_check" },
              "negative_controls": { "$ref": "#/$defs/passed_check" },
              "patch_consistency": { "$ref": "#/$defs/passed_check" }
            }
          }
        }
      },
      "else": { "required": ["failure_class"] }
    }
  ],
  "required": [
    "schema", "schema_version", "id", "case_id", "provenance",
    "expectations", "executions", "checks", "verdict", "rationale", "evidence"
  ],
  "properties": {
    "schema": { "const": "verification-result" },
    "schema_version": { "const": "0.1.0" },
    "id": {},
    "case_id": {},
    "provenance": {},
    "expectations": {
      "type": "object",
      "required": ["target_signal", "reachability", "patched_behavior"],
      "properties": {
        "target_signal": { "type": "string", "minLength": 1 },
        "reachability": { "type": "string", "minLength": 1 },
        "patched_behavior": { "type": "string", "minLength": 1 },
        "safe_behavior_signals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "executions": {
      "type": "object",
      "required": ["vulnerable", "patched", "negative_controls"],
      "properties": {
        "vulnerable": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/record_id" },
        "patched": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/record_id" },
        "negative_controls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/record_id" }
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "$ref": "#/$defs/check_set"
    },
    "verdict": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/verdict" },
    "failure_class": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/failure_class" },
    "rationale": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/artifact_ref" }
    },
    "uncertainty": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "oracle": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["passed", "summary", "evidence"],
      "properties": {
        "passed": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/artifact_ref" }
        }
      },
      "additionalProperties": false
    },
    "passed_check": {
      "allOf": [
        { "$ref": "#/$defs/check" },
        {
          "type": "object",
          "properties": { "passed": { "const": true } }
        }
      ]
    },
    "check_set": {
      "type": "object",
      "required": [
        "environment_and_build_identity",
        "same_candidate",
        "vulnerable_target_signal",
        "reachability",
        "patched_behavior",
        "negative_controls",
        "patch_consistency"
      ],
      "properties": {
        "environment_and_build_identity": { "$ref": "#/$defs/check" },
        "same_candidate": { "$ref": "#/$defs/check" },
        "vulnerable_target_signal": { "$ref": "#/$defs/check" },
        "reachability": { "$ref": "#/$defs/check" },
        "patched_behavior": { "$ref": "#/$defs/check" },
        "negative_controls": { "$ref": "#/$defs/check" },
        "patch_consistency": { "$ref": "#/$defs/check" }
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
