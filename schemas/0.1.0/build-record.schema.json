{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:schema:build-record:0.1.0",
  "title": "DACN build record",
  "type": "object",
  "allOf": [
    { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/record_envelope" },
    {
      "if": {
        "properties": { "status": { "const": "succeeded" } },
        "required": ["status"]
      },
      "then": {
        "required": ["outputs", "observed_toolchain", "dependency_resolution"],
        "properties": {
          "outputs": { "minItems": 1 },
          "observed_toolchain": { "minProperties": 1 },
          "dependency_resolution": {
            "properties": { "status": { "const": "resolved" } }
          }
        }
      },
      "else": { "required": ["failure"] }
    }
  ],
  "required": [
    "schema", "schema_version", "id", "case_id", "provenance", "role",
    "environment_id", "revision", "source_tree_sha256", "status",
    "started_at", "completed_at", "commands"
  ],
  "properties": {
    "schema": { "const": "build-record" },
    "schema_version": { "const": "0.1.0" },
    "id": {},
    "case_id": {},
    "provenance": {},
    "role": { "enum": ["vulnerable", "patched", "control"] },
    "environment_id": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/record_id" },
    "revision": { "type": "string", "minLength": 1 },
    "source_tree_sha256": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/sha256" },
    "status": { "enum": ["succeeded", "failed", "invalid"] },
    "started_at": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/timestamp" },
    "completed_at": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/timestamp" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command_result" }
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/artifact_ref" }
    },
    "failure": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/failure" },
    "observed_toolchain": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "dependency_resolution": {
      "type": "object",
      "required": ["status", "manager", "manager_version", "inventory", "checksums_verified"],
      "properties": {
        "status": { "enum": ["resolved", "partial", "failed"] },
        "manager": { "type": "string", "minLength": 1 },
        "manager_version": { "type": "string", "minLength": 1 },
        "inventory": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/artifact_ref" },
        "checksums_verified": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "dependency_inventory": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/artifact_ref" },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["classification", "description"],
        "properties": {
          "classification": { "enum": ["environment_only", "source_compatible", "semantics_changing"] },
          "description": { "type": "string", "minLength": 1 },
          "artifact": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/artifact_ref" }
        },
        "additionalProperties": false
      }
    },
    "cache_key": { "type": "string", "minLength": 1 },
    "deviations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "command_result": {
      "type": "object",
      "required": ["command", "exit_code", "stdout", "stderr"],
      "properties": {
        "command": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/command" },
        "exit_code": { "type": "integer", "minimum": 0 },
        "stdout": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/artifact_ref" },
        "stderr": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/artifact_ref" }
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
