{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:schema:environment-spec:0.1.0",
  "title": "DACN paired environment specification",
  "type": "object",
  "allOf": [{ "$ref": "urn:dacn:schema:common:0.1.0#/$defs/record_envelope" }],
  "required": [
    "schema", "schema_version", "id", "case_id", "provenance",
    "platform", "isolation", "toolchain", "dependencies", "build", "network", "limits"
  ],
  "properties": {
    "schema": { "const": "environment-spec" },
    "schema_version": { "const": "0.1.0" },
    "id": {},
    "case_id": {},
    "provenance": {},
    "platform": {
      "type": "object",
      "required": ["os", "arch"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "isolation": {
      "type": "object",
      "required": ["type", "image_digest"],
      "properties": {
        "type": { "enum": ["container", "virtual_machine"] },
        "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "object",
      "required": ["policy"],
      "properties": {
        "policy": { "enum": ["locked", "record_resolution", "unresolved"] },
        "manifests": {
          "type": "array",
          "items": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/artifact_ref" }
        },
        "locks": {
          "type": "array",
          "items": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/artifact_ref" }
        }
      },
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "required": ["configure_commands", "commands"],
      "properties": {
        "configure_commands": {
          "type": "array",
          "items": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/command" }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/command" }
        },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "expected_outputs": {
          "type": "array",
          "items": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/relative_path" }
        }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "required": ["acquisition", "build", "execution"],
      "properties": {
        "acquisition": { "type": "boolean" },
        "build": { "type": "boolean" },
        "execution": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "limits": { "$ref": "urn:dacn:schema:common:0.1.0#/$defs/limits" },
    "instrumentation": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "services": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "role_overrides": {
      "type": "object",
      "properties": {
        "vulnerable": { "$ref": "#/$defs/role_override" },
        "patched": { "$ref": "#/$defs/role_override" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "role_override": {
      "type": "object",
      "required": ["reason", "values"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "values": { "type": "object", "minProperties": 1 }
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
